# npm 12 disables non-registry ("remote") dependencies by default
# (EALLOWREMOTE). This repo pins `poetic` as a top-level release-tarball
# URL, so allow remote installs scoped to root-level dependencies only
# (not transitive).
allow-remote=root

# package.json pins engines.node to "22.x"; without this, a mismatched
# Node version only prints an EBADENGINE warning and install proceeds anyway.
engine-strict=true
