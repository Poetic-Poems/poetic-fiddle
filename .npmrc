# npm 12 disables non-registry ("remote") dependencies by default
# (EALLOWREMOTE). This repo pins `poetic` as a top-level release-tarball
# URL, so allow remote installs scoped to root-level dependencies only
# (not transitive).
allow-remote=root

# package.json pins engines.node to "22.x"; without this, a mismatched
# Node version only prints an EBADENGINE warning and install proceeds anyway.
#
# This applies to `engines.npm` just as hard, in every environment that
# installs from this directory — Vercel's build container included, and it
# ships the npm bundled with its Node 22 image (npm 10) rather than reading
# `engines.npm`. `engines.npm` is therefore a floor (">=10"), not an exact
# pin; CI gets its exact npm from the explicit `npm install -g npm@<version>`
# step in `.github/workflows/ci.yml`, which is what reproducibility rests on.
engine-strict=true
